import React, { useEffect, useMemo, useState } from 'react';
import {
  AlertTriangle,
  Calendar,
  ChevronLeft,
  ChevronRight,
  Compass,
  ExternalLink,
  MapPin,
} from 'lucide-react';
import { ITINERARY_DAYS, TEAM_ROLES } from '../data/palauProgramData';
import { ItineraryPhase, SdgCode, TeamRoleId } from '../types/program';
import { DropdownOption, DropdownSelect } from './DropdownSelect';

interface ItineraryExplorerSectionProps {
  selectedRole: TeamRoleId;
  onSelectRole: (role: TeamRoleId) => void;
  phaseFilter: ItineraryPhase;
  onChangePhaseFilter: (phase: ItineraryPhase) => void;
  selectedDayNum: number;
  onSelectDayNum: (dayNum: number) => void;
}

const PHASE_OPTIONS: DropdownOption<ItineraryPhase>[] = [
  { value: 'all', label: '全部 15 天行程（116/07/29–08/12）' },
  { value: 'arrival', label: '啟程與共識（Day 1 · 07/29）' },
  { value: 'marine', label: '海域生態與復育（Day 2–3, 10, 13）' },
  { value: 'indigenous', label: '原民部落與文化（Day 4–5, 7）' },
  { value: 'industry', label: '永續產業與市場經濟（Day 6, 8, 11）' },
  { value: 'wrapup', label: '生態調查、外交與總整（Day 9, 12, 14–15）' },
];

const SDG_OPTIONS: DropdownOption<SdgCode>[] = [
  { value: 'all', label: '全部聯合國 SDG 指標' },
  { value: 'SDG2', label: 'SDG2 零飢餓（農技團與早市）' },
  { value: 'SDG4', label: 'SDG4 優質教育（田野微訪談綜整）' },
  { value: 'SDG11', label: 'SDG11 永續城市與社區（部落與大使館）' },
  { value: 'SDG12', label: 'SDG12 責任消費與生產（農場、超市、琉璃）' },
  { value: 'SDG14', label: 'SDG14 海洋生態（洛克群島、硨磲貝、BUL）' },
  { value: 'SDG15', label: 'SDG15 陸域生態（瀑布、紅樹林、特有鳥類）' },
];

const ROLE_OPTIONS: DropdownOption<TeamRoleId>[] = TEAM_ROLES.map((r) => ({
  value: r.id,
  label: `${r.name}視角`,
}));

export const ItineraryExplorerSection: React.FC<ItineraryExplorerSectionProps> = ({
  selectedRole,
  onSelectRole,
  phaseFilter,
  onChangePhaseFilter,
  selectedDayNum,
  onSelectDayNum,
}) => {
  const [sdgFilter, setSdgFilter] = useState<SdgCode>('all');

  const filteredDays = useMemo(() => {
    return ITINERARY_DAYS.filter((day) => {
      const matchesPhase = phaseFilter === 'all' || day.phase === phaseFilter;
      const matchesSdg = sdgFilter === 'all' || day.sdgs.includes(sdgFilter);
      return matchesPhase && matchesSdg;
    });
  }, [phaseFilter, sdgFilter]);

  useEffect(() => {
    if (filteredDays.length > 0 && !filteredDays.some((d) => d.dayNumber === selectedDayNum)) {
      onSelectDayNum(filteredDays[0].dayNumber);
    }
  }, [filteredDays, selectedDayNum, onSelectDayNum]);

  const activeDay =
    filteredDays.find((d) => d.dayNumber === selectedDayNum) ??
    filteredDays[0] ??
    ITINERARY_DAYS[0];

  const dayDropdownOptions: DropdownOption<string>[] = filteredDays.map((d) => ({
    value: String(d.dayNumber),
    label: `Day ${String(d.dayNumber).padStart(2, '0')}（${d.rocDate}）— ${d.title}`,
  }));

  const activeIndexInFiltered = filteredDays.findIndex(
    (d) => d.dayNumber === activeDay.dayNumber
  );

  const currentRoleObj = TEAM_ROLES.find((r) => r.id === selectedRole) ?? TEAM_ROLES[0];

  return (
    <section id="itinerary" className="border-b border-[#E4DFD5] bg-[#FBF9F5]">
      <div className="max-w-6xl mx-auto px-4 sm:px-6 py-12 lg:py-16">
        {/* Section Header */}
        <div className="flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-8">
          <div>
            <div className="text-xs font-mono-tabular font-medium text-[#57606A] mb-2">
              02 · 15-DAY PALAU FIELD EXPEDITION
            </div>
            <h2 className="font-editorial text-2xl sm:text-3xl font-bold text-[#182026]">
              15 日帛琉實踐行程探索器（116/07/29–08/12）
            </h2>
            <p className="text-sm sm:text-base text-[#57606A] mt-2 max-w-2xl">
              利用下方下拉選單依「主題階段」、「SDG 永續指標」或「單日日期」快速篩選，並可點擊景點 Google Maps 連結預覽位置。（因應氣象預報 8/6 海況不佳，8/06 與 8/10 行程已對調）
            </p>
          </div>
          <div className="text-xs font-mono-tabular text-[#57606A] whitespace-nowrap shrink-0">
            篩選結果：{filteredDays.length} / 15 天
          </div>
        </div>

        {/* Coordinated Dropdown Filter Bar */}
        <div className="bg-white border border-[#E4DFD5] rounded-xl p-4 sm:p-5 mb-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <DropdownSelect
            label="1. 依行程主題階段篩選"
            value={phaseFilter}
            options={PHASE_OPTIONS}
            onChange={(val) => onChangePhaseFilter(val)}
          />
          <DropdownSelect
            label="2. 依聯合國 SDG 指標篩選"
            value={sdgFilter}
            options={SDG_OPTIONS}
            onChange={(val) => setSdgFilter(val)}
          />
          <DropdownSelect
            label="3. 直接選擇指定日期"
            value={String(activeDay.dayNumber)}
            options={
              dayDropdownOptions.length > 0
                ? dayDropdownOptions
                : [{ value: '1', label: '無符合日期' }]
            }
            onChange={(val) => onSelectDayNum(Number(val))}
          />
          <DropdownSelect
            label="4. 切換當日角色任務視角"
            value={selectedRole}
            options={ROLE_OPTIONS}
            onChange={onSelectRole}
          />
        </div>

        {filteredDays.length === 0 ? (
          <div className="bg-white border border-[#E4DFD5] rounded-xl p-8 text-center">
            <p className="text-sm text-[#57606A] mb-3">
              目前所選的主題階段與 SDG 指標沒有同時符合的行程日期。
            </p>
            <button
              type="button"
              onClick={() => {
                onChangePhaseFilter('all');
                setSdgFilter('all');
              }}
              className="px-4 py-2 bg-[#0E5A6F] text-white text-xs font-medium rounded-lg hover:bg-[#0A4657] cursor-pointer"
            >
              重設為全部 15 天行程
            </button>
          </div>
        ) : (
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            {/* Left: Day Selector List */}
            <div className="lg:col-span-5 border border-[#E4DFD5] rounded-xl bg-white overflow-hidden">
              <div className="px-4 py-3 bg-[#F4F0E8] border-b border-[#E4DFD5] flex items-center justify-between text-xs font-semibold text-[#57606A]">
                <span>行程日程總覽</span>
                <span className="font-mono-tabular">116 年 07–08 月</span>
              </div>
              <div className="divide-y divide-[#E4DFD5] max-h-[580px] overflow-y-auto">
                {filteredDays.map((day) => {
                  const isActive = day.dayNumber === activeDay.dayNumber;
                  return (
                    <button
                      key={day.dayNumber}
                      type="button"
                      onClick={() => onSelectDayNum(day.dayNumber)}
                      className={`w-full text-left px-4 py-3.5 transition-colors cursor-pointer flex items-start gap-3 ${
                        isActive ? 'bg-[#0E5A6F]/8' : 'hover:bg-[#FBF9F5]'
                      }`}
                    >
                      <div className="shrink-0 pt-0.5">
                        <div
                          className={`font-mono-tabular text-xs font-bold ${
                            isActive ? 'text-[#0E5A6F]' : 'text-[#57606A]'
                          }`}
                        >
                          D{String(day.dayNumber).padStart(2, '0')}
                        </div>
                        <div className="font-mono-tabular text-[11px] text-[#57606A]">
                          {day.shortDate}
                        </div>
                      </div>
                      <div className="min-w-0 flex-1">
                        <div
                          className={`text-sm font-semibold leading-snug ${
                            isActive ? 'text-[#0E5A6F]' : 'text-[#182026]'
                          }`}
                        >
                          {day.title}
                        </div>
                        <div className="text-xs text-[#57606A] mt-1 flex flex-wrap items-center gap-1.5">
                          <span>{day.phaseLabel}</span>
                          <span aria-hidden="true">·</span>
                          <span className="font-mono-tabular">
                            {day.sdgLabels.join(' / ')}
                          </span>
                          {day.adjustmentNotice && (
                            <>
                              <span aria-hidden="true">·</span>
                              <span className="text-[#9A3412] font-semibold">
                                行程已調整
                              </span>
                            </>
                          )}
                        </div>
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>

            {/* Right: Detailed Daily Field Briefing Card */}
            <div className="lg:col-span-7 bg-white border border-[#E4DFD5] rounded-xl overflow-hidden">
              {/* Top Adjustment Notice Banner for 8/06 (and 8/10) */}
              {activeDay.adjustmentNotice && (
                <div className="bg-[#FDF4ED] border-b border-[#EED2BA] px-6 sm:px-8 py-3.5 flex items-start gap-2.5">
                  <AlertTriangle
                    className="w-4 h-4 text-[#9A3412] shrink-0 mt-0.5"
                    aria-hidden="true"
                  />
                  <div className="text-xs sm:text-sm text-[#7C2D12] leading-relaxed">
                    <span className="font-bold">{activeDay.adjustmentNotice}</span>
                    {activeDay.dayNumber === 9 && (
                      <span className="block text-xs mt-0.5">
                        氣象預報 8/6 受颱風外圍環流影響，洛克群島海域船班停駛，原訂 8/6 海域行程與 8/10 陸域生態調查對調。
                      </span>
                    )}
                  </div>
                </div>
              )}

              <div className="p-6 sm:p-8">
                {/* Top Meta & Prev/Next Controls */}
                <div className="flex flex-wrap items-center justify-between gap-3 pb-5 border-b border-[#E4DFD5] mb-6">
                  <div className="flex flex-wrap items-center gap-2 text-xs text-[#57606A]">
                    <span className="inline-flex items-center gap-1 font-mono-tabular font-semibold text-[#0E5A6F]">
                      <Calendar className="w-3.5 h-3.5" aria-hidden="true" />
                      Day {String(activeDay.dayNumber).padStart(2, '0')} · {activeDay.rocDate}
                    </span>
                    <span aria-hidden="true">/</span>
                    <span>{activeDay.phaseLabel}</span>
                    <span aria-hidden="true">/</span>
                    <span className="font-mono-tabular">{activeDay.sdgLabels.join(' · ')}</span>
                  </div>

                  <div className="flex items-center gap-1.5 shrink-0">
                    <button
                      type="button"
                      disabled={activeIndexInFiltered <= 0}
                      onClick={() =>
                        onSelectDayNum(filteredDays[activeIndexInFiltered - 1].dayNumber)
                      }
                      aria-label="上一天行程"
                      className="min-h-[36px] min-w-[36px] flex items-center justify-center rounded-md border border-[#DCD6CA] text-[#182026] hover:bg-[#F4F0E8] disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                    >
                      <ChevronLeft className="w-4 h-4" />
                    </button>
                    <button
                      type="button"
                      disabled={activeIndexInFiltered >= filteredDays.length - 1}
                      onClick={() =>
                        onSelectDayNum(filteredDays[activeIndexInFiltered + 1].dayNumber)
                      }
                      aria-label="下一天行程"
                      className="min-h-[36px] min-w-[36px] flex items-center justify-center rounded-md border border-[#DCD6CA] text-[#182026] hover:bg-[#F4F0E8] disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                    >
                      <ChevronRight className="w-4 h-4" />
                    </button>
                  </div>
                </div>

                <h3 className="font-editorial text-xl sm:text-2xl font-bold text-[#182026] leading-snug mb-4">
                  {activeDay.title}
                </h3>

                {/* Locations + Google Maps Links */}
                <div className="mb-6 bg-[#FBF9F5] border border-[#E4DFD5] rounded-lg p-3.5">
                  <div className="flex items-center gap-1.5 text-xs font-semibold text-[#182026] mb-2">
                    <MapPin className="w-3.5 h-3.5 text-[#0E5A6F] shrink-0" aria-hidden="true" />
                    <span>參訪場域與 Google Maps 景點定位</span>
                  </div>
                  <div className="flex flex-col gap-1.5">
                    {activeDay.locationLinks.map((loc, idx) => (
                      <a
                        key={idx}
                        href={loc.mapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="inline-flex items-center justify-between gap-2 text-xs sm:text-sm text-[#0E5A6F] hover:text-[#0A4657] hover:underline font-medium py-1"
                      >
                        <span className="truncate">{loc.name}</span>
                        <span className="inline-flex items-center gap-1 text-xs shrink-0 whitespace-nowrap">
                          <span>開啟 Google Maps</span>
                          <ExternalLink className="w-3.5 h-3.5" aria-hidden="true" />
                        </span>
                      </a>
                    ))}
                  </div>
                </div>

                {/* Official Schedule Details */}
                <div className="mb-6">
                  <div className="text-xs font-semibold text-[#57606A] mb-2.5">
                    官方行程安排
                  </div>
                  <ul className="space-y-2 text-sm text-[#182026] leading-relaxed">
                    {activeDay.activities.map((act, i) => (
                      <li key={i} className="flex items-start gap-2.5">
                        <span className="font-mono-tabular text-xs text-[#0E5A6F] mt-1 shrink-0">
                          0{i + 1}.
                        </span>
                        <span>{act}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                {/* Role-Specific Mission */}
                <div className="bg-[#F4F0E8] border border-[#E4DFD5] rounded-lg p-4 mb-5">
                  <div className="flex items-center justify-between gap-2 mb-1.5">
                    <div className="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0E5A6F]">
                      <Compass className="w-3.5 h-3.5" aria-hidden="true" />
                      <span>你的角色當日任務（{currentRoleObj.name}）</span>
                    </div>
                    <span className="text-xs font-mono-tabular text-[#57606A]">
                      {currentRoleObj.englishTitle}
                    </span>
                  </div>
                  <p className="text-sm text-[#182026] leading-relaxed">
                    {activeDay.roleMissions[selectedRole]}
                  </p>
                </div>

                {/* First-Timer Tips */}
                <div className="border-t border-[#E4DFD5] pt-5">
                  <div className="text-xs font-semibold text-[#57606A] mb-2.5">
                    第一次去帛琉的大學生現場提醒
                  </div>
                  <ul className="space-y-2 text-sm text-[#374151] leading-relaxed">
                    {activeDay.firstTimerTips.map((tip, idx) => (
                      <li key={idx} className="flex items-start gap-2">
                        <span className="text-[#0E5A6F] font-semibold shrink-0">—</span>
                        <span>{tip}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>
  );
};
